from unittest import result

from dotenv import load_dotenv
load_dotenv()
from langchain_mistralai import ChatMistralAI
from langchain.tools import tool

#1 Creating a tool

@tool
def get_text_length(text: str) -> int: #input in string, output in integer
    """Calculate the length of the given text.""" #This is a docstring that informs the usecase of the tool to the LLM. It provides a brief description of what the function does, which is to calculate the length of the given text. The docstring is used to explain the purpose and functionality of the function, making it easier for users to understand how to use it effectively.
    return len(text)

#2 Using LLM

llm = ChatMistralAI(model="mistral-small-2506")

#3 TOOL BINDING

llm_with_tool=llm.bind_tools([get_text_length])


result=llm_with_tool.invoke("Return the number of characters in given test: Hello How are you!") #Here we are using the llm with tool binding, which means that the model can now utilize the get_text_length tool to calculate the length of the input text "hello". When we invoke the llm_with_tool with the input "hello", it will recognize that it has access to the get_text_length tool and will use it to compute the length of the text, which is 5 in this case. The result will be the output generated by the model, which may include the calculated length of the input text along with any additional response generated by the model based on its understanding of the input.

print(result.tool_calls) #This will print the tool calls made by the model during the execution of the llm_with_tool. The tool_calls attribute is a list that contains information about each tool call, including the name of the tool, the arguments passed to it, and the result returned by the tool. This allows us to see how the model utilized the get_text_length tool to calculate the length of the input text and understand the interactions between the model and the tool during the response generation process.

print(result.tool_calls[0])


#4. TOOL EXECUTION

if result.tool_calls:
    tool_call=result.tool_calls[0]
    
tool_name= tool_call["name"] #This will extract the name of the tool that was called during the execution of the llm_with_tool. The name key in the tool_call dictionary contains the name of the tool that was invoked by the model, which in this case would be "get_text_length". This allows us to identify which tool was used by the model to perform a specific task during the response generation process.

tool_args= tool_call["args"] #This will extract the arguments that were passed to the tool during the execution of the llm_with_tool. The args key in the tool_call dictionary contains a list of the arguments that were provided to the tool when it was called by the model. In this case, it would include the input text "Hello How are you!" that was passed to the get_text_length tool for processing.



tool_result = get_text_length.invoke(tool_args) #This will execute the get_text_length tool with the provided arguments. The invoke method is used to call the tool and pass the necessary arguments to it. In this case, we are passing the input text "Hello How are you!" to the get_text_length function, which will calculate the length of the text and return the result. This allows us to see the actual output generated by the tool when it is called by the model during the response generation process.


#5. Send Back to LLM
final_response = llm_with_tool.invoke(f"The length of the text is {tool_result}") #This will generate a final response using the llm_with_tool, incorporating the result obtained from the tool execution. The invoke method is used to call the language model and pass a formatted string that includes the length of the text calculated by the get_text_length tool. The model will then generate a response based on this input, which may include additional information or context related to the length of the text, providing a more comprehensive answer to the user's query. This demonstrates how the model can utilize the output from a tool to enhance its responses and provide more accurate and informative answers to user queries.

print(final_response) 